# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local env overrides (the default .env and .env.example ARE committed)
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Editor atomic-write / backup leftovers (UUID-name with a numeric suffix)
*.[0-9]*

# 照片文件名里常带日期点号（如 01-2026.09.01.jpg），会被上面那条规则误伤，
# 这里显式放行整个照片目录
!content/photos/**

# 本地临时文件
*.tmp
_notes/

# Deploy scratch directory (rewritten by scripts/deploy.mjs)
.deploy
